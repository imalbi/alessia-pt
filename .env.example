# Resend (form contatti)
RESEND_API_KEY=re_xxx_replaceme
CONTACT_EMAIL_FROM=forms@example.com
CONTACT_EMAIL_TO=alessia@example.com

# Telegram bot (form contatti)
TELEGRAM_BOT_TOKEN=000000:replaceme
TELEGRAM_CHAT_ID=000000

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public-facing fallback email shown in the contact-form error toast.
# Leave empty to show a generic "try again shortly" message instead.
NEXT_PUBLIC_CONTACT_EMAIL=

# VAT/P.IVA shown in the footer. Leave empty to hide the row entirely
# until you have a real number to ship.
NEXT_PUBLIC_VAT_NUMBER=

# Practical info shown in the contact-section sidebar. Leave a row empty
# to hide it (rates row is always shown — the value is "shared after
# the first message", which is intentional and works without an env).
NEXT_PUBLIC_STUDIO_CITY=
NEXT_PUBLIC_STUDIO_MODES=

# Cloudflare Web Analytics (vuoto in dev e preview, set in production)
NEXT_PUBLIC_CF_BEACON=
